# Copy to .env locally. Do not paste keys into tickets or the interface.
SUPPORT_MODE=sample
FRESHDESK_DOMAIN=your-subdomain.freshdesk.com
FRESHDESK_API_KEY=replace-locally
# At least one scope is REQUIRED in freshdesk mode. Both means intersection.
FRESHDESK_TICKET_IDS=123,456
FRESHDESK_GROUP_ID=
# Custom fields containing your canonical customer/site IDs:
FRESHDESK_CUSTOMER_FIELD=company_id
FRESHDESK_SITE_FIELD=cf_location
# Optional existing custom-field names; leave blank when unknown.
FRESHDESK_MODEL_FIELD=
FRESHDESK_VERSION_FIELD=

# Optional chat model. Local preview works without a key.
CHAT_PROVIDER=local
OPENAI_API_KEY=replace-locally
OPENAI_MODEL=gpt-4.1-mini
# Set true only after authorizing OpenAI to receive fictional chat and matched
# sandbox product guidance excerpts. Real tickets are not supported by chat.
CHAT_ALLOW_PRODUCT_EXCERPTS=false

# CHAT_PROVIDER=openai enables real sandbox calls once key/model/consent are set.
# SUPPORT_MODE selects the ticket reader only; it does not select a chat model.
# Process environment overrides this file. Restart the server after changes.
